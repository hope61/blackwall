# ─────────────────────────────────────────────────────────────
#  BLACKWALL — credentials
#  Copy to .env and fill in. Every key here is OPTIONAL.
#  The dashboard runs fully without any of them; panels that
#  find a token upgrade themselves to a better data source.
# ─────────────────────────────────────────────────────────────

# Cloudflare Radar — country-level internet outage detection
#   dash.cloudflare.com > My Profile > API Tokens > Create Token
#   > Custom token > Permissions: Account · Radar · Read
#   Free account, no domain required, read-only.
#   UPGRADES: outages panel gains real national traffic anomalies,
#             BGP hijack confirmation, attack-layer traffic mix.
CF_RADAR_TOKEN=

# abuse.ch — URLhaus / ThreatFox / Feodo unified auth key
#   auth.abuse.ch > sign up free > Auth-Key
#   UPGRADES: malware C2 panel gains live URLhaus + ThreatFox IOCs
#             instead of Feodo blocklist only.
ABUSECH_AUTH_KEY=

# GitHub personal access token — no scopes needed (public data only)
#   github.com/settings/tokens > Generate new token (classic)
#   > select NO scopes at all
#   UPGRADES: rate limit 60/hr -> 5000/hr. Without it the trending
#             panel may go STALE during heavy refreshing.
GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────
#  Server
# ─────────────────────────────────────────────────────────────
PORT=8787

# Bind address. Defaults to 127.0.0.1 — the server proxies your credentials, so
# it should not be reachable from the network unless you mean it to be.
# Containers override this to 0.0.0.0 and publish only to the host loopback.
HOST=127.0.0.1

# Geolocation for ISS passes, local time, egress comparison.
# Leave blank to auto-detect from your public IP.
OPERATOR_LAT=
OPERATOR_LON=
OPERATOR_LABEL=
